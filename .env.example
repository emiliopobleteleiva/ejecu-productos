# Puerto interno del contenedor. Siempre 8080.
API_PORT=8080

# dev | test | prod. En prod no se publican /api/docs ni el spec.
API_ENV=dev

# Conexión a la base propia del servicio.
# Dentro de Compose, el host es el nombre del servicio (postgres), no localhost.
DATABASE_URL=postgres://replace-with-user:replace-with-password@postgres:5432/replace-with-db?sslmode=disable

# JWKS del servicio de identidad para validar JWT.
AUTH_JWKS_URL=replace-with-jwks-url

# Origen permitido para el frontend.
FRONTEND_URL=replace-with-frontend-url

# Zona horaria del servicio.
TZ=America/Santiago

# URL interna de servicios de los que dependa productos.
# Si las categorías viven en otro servicio, descomentar:
# CATEGORIAS_URL=replace-with-categorias-url

# SonarCloud no va aquí. SONAR_TOKEN y SONAR_HOST_URL se configuran
# como secrets de GitHub Actions, no en el repositorio.
